          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source vérifie le certificat du serveur (verify-ca/verify-full). Tabula chiffre la connexion (REQUIRED) mais ne vérifie pas le certificat."
          }
        },
        "it" : {
          "stringUnit" : {
