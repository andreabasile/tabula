    "A row to save no longer matches: it was changed or deleted in the meantime, or a security policy hides it. Nothing was saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zu sichernde Zeile stimmt nicht mehr überein: Sie wurde zwischenzeitlich geändert oder gelöscht, oder eine Sicherheitsrichtlinie blendet sie aus. Es wurde nichts gesichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne à enregistrer ne correspond plus : elle a été modifiée ou supprimée entre-temps, ou une politique de sécurité la masque. Rien n’a été enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una riga da salvare non corrisponde più: nel frattempo è stata modificata o eliminata, oppure una policy di sicurezza la nasconde. Non è stato salvato nulla."
          }
        }
      }
    },
    "A transaction is open in this session: commit or roll it back before saving edits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Sitzung ist eine Transaktion offen: vor dem Sichern der Änderungen committen oder zurückrollen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une transaction est ouverte dans cette session : validez-la ou annulez-la avant d’enregistrer les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questa sessione c'è una transazione aperta: esegui commit o rollback prima di salvare le modifiche."
          }
        }
      }
    },
    "AWS CLI not found. Install it with `brew install awscli`: Tabula looks for `aws` in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AWS CLI nicht gefunden. Installation mit `brew install awscli`: Tabula sucht `aws` in %@."
