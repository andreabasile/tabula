    "-- Write your query here. ⌘↩ runs the current statement, ⇧⌘↩ runs everything.\n-- ⌃Space or Esc for suggestions; after JOIN it suggests a table and an ON condition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-- Abfrage hier schreiben. ⌘↩ führt das aktuelle Statement aus, ⇧⌘↩ alles.\n-- ⌃Leertaste oder Esc für Vorschläge; nach JOIN werden Tabelle und ON-Bedingung vorgeschlagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-- Écrivez la requête ici. ⌘↩ exécute l’instruction courante, ⇧⌘↩ tout.\n-- ⌃Espace ou Échap pour les suggestions ; après JOIN, propose table et condition ON."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-- Scrivi la query qui. ⌘↩ esegue lo statement corrente, ⇧⌘↩ tutto.\n-- ⌃Spazio o Esc per i suggerimenti; dopo JOIN propone tabella e condizione ON."
          }
        }
      }
    },
